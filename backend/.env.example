# 本地默认值；容器生产环境使用持久卷，例如 sqlite:////data/studypal.db
STUDYPAL_DATABASE_URL=sqlite:///./studypal.db
STUDYPAL_JWT_SECRET=replace-with-at-least-32-random-characters
STUDYPAL_JWT_ALGORITHM=HS256
STUDYPAL_ACCESS_TOKEN_TTL_MINUTES=30
STUDYPAL_REFRESH_TOKEN_TTL_DAYS=7
STUDYPAL_DEEPSEEK_API_KEY=
STUDYPAL_DEEPSEEK_BASE_URL=https://api.deepseek.com
STUDYPAL_DEEPSEEK_MODEL=deepseek-chat
# 逗号分隔的完整 origin，不带路径；生产示例：https://owner.github.io
STUDYPAL_CORS_ORIGINS=http://localhost:5173
# 生产环境同样使用 IANA 时区名称
STUDYPAL_TIMEZONE=Asia/Shanghai
